diff --git a/hw/audio/virtio-snd.c b/hw/audio/virtio-snd.c
index 6df7ea0eb0..ec362fb676 100644
--- a/hw/audio/virtio-snd.c
+++ b/hw/audio/virtio-snd.c
@@ -280,6 +280,139 @@ static void virtio_snd_handle_pcm_info(VirtIOSound *s,
                  cmd->payload_size);
 }
 
+/*
+ * Validate an item information request against @total items and the
+ * response buffer, as virtio_snd_handle_pcm_info does for streams.
+ * Returns false, with the response code set, when the request is malformed.
+ */
+static bool virtio_snd_query_valid(virtio_snd_ctrl_command *cmd,
+                                   const char *what, uint32_t total,
+                                   size_t item_size, uint32_t *start_id,
+                                   uint32_t *count)
+{
+    virtio_snd_query_info req;
+    uint32_t tmp, size;
+    size_t msg_sz = iov_to_buf(cmd->elem->out_sg, cmd->elem->out_num, 0,
+                               &req, sizeof(virtio_snd_query_info));
+
+    if (msg_sz != sizeof(virtio_snd_query_info)) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s info: virtio-snd command size incorrect %zu vs %zu\n",
+                      what, msg_sz, sizeof(virtio_snd_query_info));
+        cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_BAD_MSG);
+        return false;
+    }
+    *start_id = le32_to_cpu(req.start_id);
+    *count = le32_to_cpu(req.count);
+    size = le32_to_cpu(req.size);
+    if (*start_id > total || !g_uint_checked_add(&tmp, *start_id, *count) ||
+        tmp > total) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s info: start_id %u + count %u exceeds %u items\n",
+                      what, *start_id, *count, total);
+        cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_BAD_MSG);
+        return false;
+    }
+    if (*count && (size < item_size ||
+                   !g_uint_checked_mul(&tmp, size, *count) ||
+                   !g_uint_checked_add(&tmp, tmp, sizeof(virtio_snd_hdr)) ||
+                   iov_size(cmd->elem->in_sg, cmd->elem->in_num) < tmp)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s info: response buffer too small\n",
+                      what);
+        cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_BAD_MSG);
+        return false;
+    }
+    return true;
+}
+
+/*
+ * Handle the VIRTIO_SND_R_JACK_INFO request: one jack per configured jack,
+ * all connected, each a line out (even ids) or line in (odd ids) pin of the
+ * stream with the same parity, described by its HDA pin default
+ * configuration (High Definition Audio Specification 7.3.3.31).
+ *
+ * This used to answer VIRTIO_SND_S_NOT_SUPP whatever was asked. macOS 27's
+ * AppleVirtIOSound asks for jack and channel map information while it
+ * starts, even with zero jacks configured, and an unsupported answer leaves
+ * the driver started but never registered: the guest has no audio device.
+ */
+static void virtio_snd_handle_jack_info(VirtIOSound *s,
+                                        virtio_snd_ctrl_command *cmd)
+{
+    uint32_t start_id, count;
+    g_autofree virtio_snd_jack_info *jack_info = NULL;
+
+    if (!virtio_snd_query_valid(cmd, "jack", s->snd_conf.jacks,
+                                sizeof(virtio_snd_jack_info), &start_id,
+                                &count)) {
+        return;
+    }
+    jack_info = g_new0(virtio_snd_jack_info, count ? count : 1);
+    for (uint32_t i = 0; i < count; i++) {
+        uint32_t id = start_id + i;
+        bool output = (id % 2) == 0;
+
+        jack_info[i].hdr.hda_fn_nid = cpu_to_le32(id);
+        jack_info[i].features = 0;
+        /* Jack, rear, line out (green) / line in (blue), 1/8" connector. */
+        jack_info[i].hda_reg_defconf =
+            cpu_to_le32(output ? 0x01014010 : 0x01813020);
+        jack_info[i].hda_reg_caps = 0;
+        jack_info[i].connected = 1;
+    }
+    cmd->payload_size = sizeof(virtio_snd_jack_info) * count;
+    cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_OK);
+    if (count) {
+        iov_from_buf(cmd->elem->in_sg, cmd->elem->in_num,
+                     sizeof(virtio_snd_hdr), jack_info, cmd->payload_size);
+    }
+}
+
+/*
+ * Handle the VIRTIO_SND_R_CHMAP_INFO request: channel map i belongs to
+ * stream i (or to the last stream), in that stream's direction, with its
+ * channels at front left and front right (front center for a mono stream).
+ * See virtio_snd_handle_jack_info for why it is answered rather than refused.
+ */
+static void virtio_snd_handle_chmap_info(VirtIOSound *s,
+                                         virtio_snd_ctrl_command *cmd)
+{
+    uint32_t start_id, count;
+    g_autofree virtio_snd_chmap_info *chmap_info = NULL;
+
+    trace_virtio_snd_handle_chmap_info();
+    if (!virtio_snd_query_valid(cmd, "chmap", s->snd_conf.chmaps,
+                                sizeof(virtio_snd_chmap_info), &start_id,
+                                &count)) {
+        return;
+    }
+    chmap_info = g_new0(virtio_snd_chmap_info, count ? count : 1);
+    for (uint32_t i = 0; i < count; i++) {
+        uint32_t id = start_id + i;
+        uint32_t stream_id = MIN(id, s->snd_conf.streams - 1);
+        VirtIOSoundPCMStream *stream = virtio_snd_pcm_get_stream(s, stream_id);
+        uint8_t channels = stream ? MAX(stream->info.channels_max, 1) : 2;
+
+        chmap_info[i].hdr.hda_fn_nid = cpu_to_le32(stream_id);
+        chmap_info[i].direction = stream ? stream->info.direction
+                                         : VIRTIO_SND_D_OUTPUT;
+        if (channels == 1) {
+            chmap_info[i].channels = 1;
+            chmap_info[i].positions[0] = VIRTIO_SND_CHMAP_MONO;
+        } else {
+            chmap_info[i].channels = 2;
+            chmap_info[i].positions[0] = VIRTIO_SND_CHMAP_FL;
+            chmap_info[i].positions[1] = VIRTIO_SND_CHMAP_FR;
+        }
+    }
+    cmd->payload_size = sizeof(virtio_snd_chmap_info) * count;
+    cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_OK);
+    if (count) {
+        iov_from_buf(cmd->elem->in_sg, cmd->elem->in_num,
+                     sizeof(virtio_snd_hdr), chmap_info, cmd->payload_size);
+    }
+}
+
 /*
  * Set the given stream params.
  * Returns the response status code. (VIRTIO_SND_S_*).
@@ -793,9 +926,11 @@ process_cmd(VirtIOSound *s, virtio_snd_ctrl_command *cmd)
 
     switch (code) {
     case VIRTIO_SND_R_JACK_INFO:
+        virtio_snd_handle_jack_info(s, cmd);
+        break;
     case VIRTIO_SND_R_JACK_REMAP:
         qemu_log_mask(LOG_UNIMP,
-                     "virtio_snd: jack functionality is unimplemented.\n");
+                     "virtio_snd: jack remapping is unimplemented.\n");
         cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_NOT_SUPP);
         break;
     case VIRTIO_SND_R_PCM_INFO:
@@ -817,10 +952,7 @@ process_cmd(VirtIOSound *s, virtio_snd_ctrl_command *cmd)
         virtio_snd_handle_pcm_release(s, cmd);
         break;
     case VIRTIO_SND_R_CHMAP_INFO:
-        qemu_log_mask(LOG_UNIMP,
-                     "virtio_snd: chmap info functionality is unimplemented.\n");
-        trace_virtio_snd_handle_chmap_info();
-        cmd->resp.code = cpu_to_le32(VIRTIO_SND_S_NOT_SUPP);
+        virtio_snd_handle_chmap_info(s, cmd);
         break;
     default:
         /* error */
