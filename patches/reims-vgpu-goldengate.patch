+/// Bytes per single sample in a buffer<->multisample-texture copy under `options`.
+fn promoted_msaa_unit_bytes(
+    raw: &rt::Texture,
+    options: rt::BlitOption,
+    sel: &'static str,
+) -> Option<usize> {
+    let bytes = match options {
+        rt::BlitOption::StencilFromDepthStencil => 1,
+        rt::BlitOption::DepthFromDepthStencil => match plain(|| raw.pixel_format()) {
+            PixelFormat::Depth16Unorm => 2,
+            _ => 4,
+        },
+        rt::BlitOption::None => {
+            let pf = plain(|| raw.pixel_format());
+            let b = crate::gpu::format_info::block(
+                sel,
+                u64::from(pf.as_raw()),
+                "a multisampled blit copy of",
+            );
+            if b.compressed() {
+                return None;
+            }
+            b.bytes()
+        }
+        _ => return None,
+    };
+    usize::try_from(bytes).ok().filter(|&u| u > 0)
