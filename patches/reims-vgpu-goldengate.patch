+/// Whether this process has logged its relaxed 4-sample substitution for a 2-sample request.
+static RELAYED_SAMPLE_COUNT_2: std::sync::atomic::AtomicBool =
+    std::sync::atomic::AtomicBool::new(false);
+
+/// Substitutes 4 samples for `samples == 2` outside strict mode when the device supports 4 samples
+/// without 2 samples.
+fn promoted_sample_count(
+    sel: &'static str,
+    samples: u64,
+    supports_2: bool,
+    supports_4: bool,
+) -> u64 {
+    if samples == 2 && !crate::answer::strict() && !supports_2 && supports_4 {
+        if !RELAYED_SAMPLE_COUNT_2.swap(true, std::sync::atomic::Ordering::Relaxed) {
+            log::warn!(
+                "{sel}: sampleCount 2 promoted to 4 outside strict mode because the Vulkan \
+                 device supports 4x MSAA without 2x MSAA"
+            );
+        }
+        return 4;
+    }
+    samples
+}
