+
+/// Host callbacks run once when a command buffer's GPU work finishes.
+#[derive(Default)]
+pub(crate) struct PostGpuCopies(Mutex<Vec<Box<dyn FnOnce() + Send>>>);
+
+impl std::fmt::Debug for PostGpuCopies {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_tuple("PostGpuCopies")
+            .field(&self.0.lock().len())
+            .finish()
+    }
+}
+
+impl PostGpuCopies {
+    pub(crate) fn push(&self, f: Box<dyn FnOnce() + Send>) {
+        self.0.lock().push(f);
+    }
+
+    pub(crate) fn is_empty(&self) -> bool {
+        self.0.lock().is_empty()
+    }
+
+    pub(crate) fn run(&self) {
+        let callbacks = std::mem::take(&mut *self.0.lock());
+        for cb in callbacks {
+            cb();
+        }
+    }
 }
 
