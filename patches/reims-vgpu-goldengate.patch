index 9b6d04fa..df17b6cf 100644
--- a/crates/reims-vgpu-core/src/guest/records.rs
+++ b/crates/reims-vgpu-core/src/guest/records.rs
@@ -22,7 +22,20 @@ use crate::num::Truncate;
 /// serves arm64 guests, an x86-64 build x86-64 ones (core's tests also run as x86-64 under
 /// Rosetta on a Mac). Every page number the guest hands the device counts these pages. Name is
 /// ours: the shift of `APV_PAGE_SIZE`.
-pub const APV_PAGE_SHIFT: u32 = if cfg!(target_arch = "x86_64") { 12 } else { 14 };
+///
+/// `RVG_GUEST_PAGE_SHIFT=14` (or `12`) in the build's environment overrides it, for an arm64
+/// guest that QEMU's TCG runs on an x86-64 host.
+pub const APV_PAGE_SHIFT: u32 = match option_env!("RVG_GUEST_PAGE_SHIFT") {
+    Some(s) if s.len() == 2 && s.as_bytes()[0] == b'1' && s.as_bytes()[1] == b'4' => 14,
+    Some(s) if s.len() == 2 && s.as_bytes()[0] == b'1' && s.as_bytes()[1] == b'2' => 12,
+    _ => {
+        if cfg!(target_arch = "x86_64") {
+            12
+        } else {
+            14
+        }
+    }
+};
 
 /// `APV_PAGE_SIZE`: the guest page size, 16 KiB (4 KiB on x86-64).
 pub const APV_PAGE_SIZE: u64 = 1_u64.wrapping_shl(APV_PAGE_SHIFT);
