+/// Switches the window between windowed and the compositor's full screen (Ctrl+Alt+F,
+/// `super::input`). The window's resize events that follow lay the image out again, keeping the
+/// guest's ratio between black bars, as for any other resize.
+fn toggle_full_screen(shell: &Shell) {
+    // SAFETY: the window is SDL's, on this thread.
+    let flags = unsafe { SDL_GetWindowFlags(shell.sdl) };
+    let full = (flags & SDL_WINDOW_FULLSCREEN).0 != 0;
+    // SAFETY: as above.
+    let asked = unsafe { SDL_SetWindowFullscreen(shell.sdl, !full) };
+    log::info!(
+        target: "reims_vgpu_window",
+        "window {:?}: {} full screen{}",
+        shell.window.title(),
+        if full { "leaving" } else { "entering" },
+        if asked { String::new() } else { format!(" refused: {}", crate::sdl::sdl_error()) }
+    );
+}
